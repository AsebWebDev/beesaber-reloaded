# Copy to server/.env. The defaults work with `docker compose up -d`.

# Port the API listens on. The client's dev server forwards /api to it.
PORT=5001

# The built frontend, to have this server hand it out along with the API.
# Leave empty in development, where `pnpm client` serves the frontend. To try
# the production setup locally: `pnpm build`, then set ../client/dist here.
FRONTEND_DIR=

# Connection string of the Postgres database
DATABASE_URL=postgres://beesaber:beesaber@localhost:5432/beesaber

# ScoreSaber's live feed of new scores. Set to false to run without it;
# scores then arrive with the periodic sync and on request only.
LIVE_FEED=true

# The address people open in their browser, without a path. Sign-in
# redirects go here. Must be https unless it is localhost.
APP_URL=http://localhost:3000

# Signs the session cookies. Generate your own, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Sign-in with Google. Create an OAuth client of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   http://localhost:3000/api/auth/callback/google
# Leave both empty to switch sign-in with Google off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lets anyone create an account with just an email and a password, without
# verification, and makes the client show a "Dev Login" button. For trying
# the app on your own machine without Google credentials. The server refuses
# to start with this unless APP_URL points to localhost.
DEV_LOGIN=true

# Set to true only when the server runs behind a reverse proxy that sets the
# X-Forwarded-For header. The rate limit then counts by the address in that
# header. Without a proxy it must stay false.
TRUST_PROXY=false
