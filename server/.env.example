# Copy to server/.env. The defaults work with `docker compose up -d`.

# Port the API listens on. The client's dev server forwards /api to it.
PORT=5001

# Connection string of the Postgres database
DATABASE_URL=postgres://beesaber:beesaber@localhost:5432/beesaber

# The address people open in their browser. Sign-in redirects go here.
APP_URL=http://localhost:3000

# Signs the session cookies. Generate your own, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Sign-in with Google. Create an OAuth client of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   http://localhost:3000/api/auth/callback/google
# Leave both empty to switch sign-in with Google off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development only: lets the client sign in as a local test account, so you
# can work without Google credentials. The server refuses to start with this
# in production.
DEV_LOGIN=true
