{
  "name": "@beesaber/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:update": "tsx scripts/updateOpenApi.ts && pnpm gen:api",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "gen:api": "openapi-typescript src/scoresaber/openapi.json -o src/scoresaber/openapi.d.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "openapi-fetch": "^0.17.0",
    "pg-boss": "^12.38.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": "./src/app.ts"
  }
}
