{
  "name": "@beesaber/client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "craco build",
    "eject": "craco eject",
    "lint:js": "eslint . --ext .js,.jsx",
    "lint:js:fix": "pnpm lint:js --fix",
    "lint:scss": "stylelint 'src/**/*.scss' scss",
    "lint:scss:fix": "stylelint 'src/**/*.scss' scss --fix",
    "msw": "cross-env REACT_APP_MSW='enabled' craco start",
    "start": "craco start",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "dependencies": {
    "@beesaber/shared": "workspace:*",
    "@craco/craco": "^6.4.5",
    "@reduxjs/toolkit": "^2.7.0",
    "axios": "^0.24.0",
    "date-fns": "^2.30.0",
    "mdb-react-ui-kit": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-google-login": "^5.2.2",
    "react-is": "^19.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^5.3.4",
    "react-scripts": "5.0.1",
    "react-toastify": "^8.2.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "sass": "^1.87.0",
    "styled-components": "^5.3.11",
    "web-vitals": "^1.1.2"
  },
  "devDependencies": {
    "@types/eslint": "^7.29.0",
    "@types/node": "^12.20.55",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@types/react-redux": "^7.1.34",
    "@types/react-router-dom": "^5.3.3",
    "@types/sass": "^1.43.1",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "craco-alias": "^3.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^7.32.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "msw": "^0.36.8",
    "postcss": "^8.3.11",
    "postcss-scss": "^4.0.1",
    "prettier": "^2.8.8",
    "react-country-flag": "^3.1.0",
    "redux-devtools-extension": "^2.13.9",
    "stylelint": "^14.16.1",
    "stylelint-config-standard-scss": "^2.0.1",
    "stylelint-order": "^5.0.0",
    "stylelint-scss": "^4.7.0",
    "typescript": "^4.9.5"
  },
  "msw": {
    "workerDirectory": "public"
  }
}
