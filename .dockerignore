# What `docker build` may not copy into the image. Installed packages and
# build output are made fresh inside the image; secrets never go in.

**/node_modules
**/dist
**/coverage
**/*.log

# Local settings and secrets
**/.env
**/.env.*
!**/.env.example

# Not needed to build or run the app
.git
.github
.husky
.vscode
docker
docker-compose.yml
# Terraform for Azure: its downloads, settings and the subscription id
infra
Dockerfile
.dockerignore
