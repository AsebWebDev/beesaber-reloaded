{
  "name": "beesaber-reloaded",
  "version": "0.1.0",
  "private": true,
  "description": "Compare your Beat Saber scores with your friends",
  "scripts": {
    "client": "pnpm --filter @beesaber/client start",
    "client:mock": "pnpm --filter @beesaber/client msw",
    "server": "pnpm --filter @beesaber/server dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @beesaber/client exec cross-env REACT_APP_MSW=enabled jest",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^2.8.8"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  }
}
