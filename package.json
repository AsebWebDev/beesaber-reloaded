{
  "name": "beesaber-reloaded",
  "version": "0.1.0",
  "private": true,
  "description": "Compare your Beat Saber scores with your friends",
  "scripts": {
    "client": "pnpm --filter @beesaber/client dev",
    "client:mock": "pnpm --filter @beesaber/client dev:mock",
    "server": "pnpm --filter @beesaber/server dev",
    "db": "docker compose up -d --wait",
    "db:migrate": "pnpm --filter @beesaber/server db:migrate",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,scss}": "prettier --write"
  }
}
